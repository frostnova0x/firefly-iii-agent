# ============================================================
# firefly-iii-agent — environment variables
# ============================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
#
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env to version control. NEVER share it.
# These secrets give full read+write access to your finances.
# ============================================================


# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

# Get from @BotFather on Telegram. Looks like: 1234567890:ABC...
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID. Get yours from @userinfobot.
# Multiple owners: comma-separated, e.g. "123456,789012".
# Anyone NOT in this list is silently ignored by the bot.
TELEGRAM_OWNER_IDS=


# ------------------------------------------------------------
# OpenRouter (LLM provider)
# ------------------------------------------------------------

# Sign up at https://openrouter.ai → Keys → Create Key.
# Add ~$5 of credits. The bot uses ~$0.20-1.00/month at typical volume.
OPENROUTER_API_KEY=

# Optional: identify your deployment in OpenRouter analytics.
# Doesn't need to be a real URL. Defaults are fine.
# OPENROUTER_HTTP_REFERER=https://github.com/your-username/firefly-iii-agent
# OPENROUTER_X_TITLE=firefly-bot


# ------------------------------------------------------------
# Firefly III
# ------------------------------------------------------------

# Base URL of your Firefly III install. NO trailing slash.
# Examples:
#   http://firefly:8080            (when bot + Firefly are in the same docker network)
#   https://firefly.example.com    (when Firefly is behind a reverse proxy)
FIREFLY_URL=

# Personal Access Token from Firefly III.
# Get from: Profile → OAuth → Personal Access Tokens → Create New Token
# Copy the LONG token (starts with eyJ...). It's shown ONCE; store it now.
FIREFLY_PAT=


# ------------------------------------------------------------
# Account routing
# ------------------------------------------------------------

# The default ASSET account name (case-insensitive) — typically your
# checking/savings account. Must match an account name in Firefly III.
# Bot fails to start if this name doesn't exist.
DEFAULT_ASSET_ACCOUNT_NAME=

# Optional: liability account names that the bot is allowed to use,
# comma-separated. These are typically BNPL or credit-card accounts.
# Bot fails to start if any name listed here doesn't exist.
LIABILITY_ACCOUNT_NAMES=


# ------------------------------------------------------------
# Currencies
# ------------------------------------------------------------

# 3-letter ISO codes. Set DEFAULT_CURRENCY to whatever you use most.
DEFAULT_CURRENCY=USD
SECONDARY_CURRENCY=EUR


# ------------------------------------------------------------
# Runtime behavior
# ------------------------------------------------------------

# How long a pending transaction (preview) stays valid before expiring.
# Lower = less stale state; higher = easier to reply later.
PENDING_TTL_MINUTES=30

# Log verbosity. DEBUG is noisy but useful when debugging.
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Paths (only override if you know what you're doing)
# ------------------------------------------------------------

# Where the bot stores its SQLite state.
# In Docker, this maps to /app/data via the compose volume.
# STATE_DB_PATH=./data/state.db

# Where to read user-editable config from.
# CONFIG_TOML_PATH=./config.toml
